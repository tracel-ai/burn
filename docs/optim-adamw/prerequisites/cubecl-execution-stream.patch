+//! The client execution stream follows its pin, or the calling scope when unpinned.
+
+use cubecl_cpu::CpuRuntime;
+use cubecl_environment::stream::StreamId;
+use cubecl_server::runtime::Runtime;
+
+#[test]
+fn unpinned_client_follows_nested_scopes_without_changing_them() {
+    let client = CpuRuntime::client(&Default::default());
+    let cloned = client.clone();
+    let original = StreamId::current();
+    let outer = StreamId::allocate();
+    let inner = StreamId::allocate();
+    assert_ne!(outer, inner);
+    assert_eq!(client.execution_stream(), original);
+
+    outer.executes(|| {
+        assert_eq!(client.execution_stream(), outer);
+        assert_eq!(cloned.execution_stream(), outer);
+        assert_eq!(client.empty(16).stream, outer);
+        assert_eq!(StreamId::current(), outer);
+
+        inner.executes(|| {
+            assert_eq!(client.execution_stream(), inner);
+            assert_eq!(cloned.execution_stream(), inner);
+            assert_eq!(client.empty(16).stream, inner);
+            assert_eq!(StreamId::current(), inner);
+        });
+
+        assert_eq!(client.execution_stream(), outer);
+        assert_eq!(StreamId::current(), outer);
+    });
+
+    assert_eq!(client.execution_stream(), original);
+    assert_eq!(StreamId::current(), original);
+}
+
+#[test]
+fn pinned_client_and_its_clone_keep_the_pin_in_other_scopes() {
+    let unpinned = CpuRuntime::client(&Default::default());
+    let mut pinned = unpinned.clone();
+    let stream = StreamId::allocate();
+    // No buffers or work have been issued through this clone before selecting its stream.
+    unsafe { pinned.set_stream(stream) };
+    let cloned = pinned.clone();
+    let original = StreamId::current();
+
+    for scope in [StreamId::allocate(), StreamId::allocate()] {
+        assert_ne!(scope, stream);
+        scope.executes(|| {
+            assert_eq!(pinned.execution_stream(), stream);
+            assert_eq!(cloned.execution_stream(), stream);
+            assert_eq!(pinned.empty(16).stream, stream);
+            assert_eq!(unpinned.execution_stream(), scope);
+            assert_eq!(StreamId::current(), scope);
+        });
+    }
+
+    assert_eq!(pinned.execution_stream(), stream);
+    assert_eq!(cloned.execution_stream(), stream);
+    assert_eq!(unpinned.execution_stream(), original);
+    assert_eq!(StreamId::current(), original);
+}
